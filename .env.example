# Application
APP_NAME=Docker Manager
HOST=0.0.0.0
PORT=8080

# Docker Engine socket (default: local socket)
DOCKER_SOCKET=unix:///var/run/docker.sock

# Where backups are stored inside the container
BACKUP_DIR=/app/backups

# Frontend polling interval (seconds)
POLL_INTERVAL=5

# Default number of log lines
LOG_DEFAULT_LINES=500

# Maximum backup upload size in MB
MAX_UPLOAD_MB=4096

# Optional simple bearer-token auth. Leave empty to disable (trusted LAN only!).
AUTH_TOKEN=1234

# Log level
LOG_LEVEL=INFO

# Application version (shown in footer and /api/system)
APP_VERSION=1.0.0
